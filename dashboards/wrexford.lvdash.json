{
  "datasets": [
    {
      "name": "tieout_daily",
      "displayName": "Tie-out rate by date",
      "queryLines": [
        "SELECT business_date, tie_out_rate * 100 AS tie_out_pct, matched, breaks, pending, explained_upstream ",
        "FROM keelstone.wrexford.gold_tieout_daily"
      ]
    },
    {
      "name": "tieout_overall",
      "displayName": "Tie-out rate, all dates",
      "queryLines": [
        "SELECT round(100 * sum(matched) / (sum(positions_compared) - sum(pending)), 2) AS tie_out_pct, ",
        "sum(breaks) AS breaks, sum(pending) AS pending FROM keelstone.wrexford.gold_tieout_daily"
      ]
    },
    {
      "name": "exposure_asset_class",
      "displayName": "Exposure by asset class, latest date",
      "queryLines": [
        "SELECT asset_class, market_value_usd, weight FROM keelstone.wrexford.gold_exposure_asset_class ",
        "WHERE business_date = (SELECT max(business_date) FROM keelstone.wrexford.gold_tieout_daily)"
      ]
    },
    {
      "name": "exposure_currency",
      "displayName": "Exposure by currency, latest date",
      "queryLines": [
        "SELECT currency, market_value_usd, market_value_local, weight FROM keelstone.wrexford.gold_exposure_currency ",
        "WHERE business_date = (SELECT max(business_date) FROM keelstone.wrexford.gold_tieout_daily)"
      ]
    },
    {
      "name": "breaks_by_reason",
      "displayName": "Non-matched positions by reason",
      "queryLines": [
        "SELECT status, reason_code, count(*) AS positions FROM keelstone.wrexford.gold_reconciliation ",
        "WHERE status <> 'matched' GROUP BY status, reason_code"
      ]
    },
    {
      "name": "break_queue",
      "displayName": "Break queue",
      "queryLines": [
        "SELECT business_date, custodian, account_id, security_id, status, reason_code, ",
        "quantity_difference, value_difference FROM ",
        "keelstone.wrexford.gold_break_queue"
      ]
    }
  ],
